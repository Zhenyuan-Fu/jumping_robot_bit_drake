package jumping_robot_trunk_lcm;

struct jumping_robot_trunk_state_t
{
    double timestamp;

    boolean finished;  // indicate that this is the end of the trajectory

    // Base linear position/velocity/accel
    double base_p[3];
    double base_pd[3];
    double base_pdd[3];

    // Base angular position/velocity/accel
    double base_rpy[3];
    double base_rpyd[3];
    double base_rpydd[3];

    // Foot positions
    double lfoot_p[3];
    double rfoot_p[3];

    // Foot velocities
    double lfoot_pd[3];
    double rfoot_pd[3];

    // Foot accelerations
    double lfoot_pdd[3];
    double rfoot_pdd[3];

    // Foot contact states
    boolean lfoot_contact;
    boolean rfoot_contact;

    // Foot contact forces
    double lfoot_f[6];
    double rfoot_f[6];

}

